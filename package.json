{
  "name": "create-modern-mern-app",
  "version": "3.0.5",
  "description": "Interactive CLI generator for production-ready MERN stack apps with Vite, React, Express, and MongoDB",
  "type": "module",
  "bin": {
    "create-modern-mern-app": "bin/index.js"
  },
  "main": "./src/cli.js",
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/index.js",
    "test": "node --test test/*.test.js",
    "lint": "oxlint bin src test scripts --deny-warnings",
    "test:packed": "node scripts/test-packed.js"
  },
  "keywords": [
    "cli",
    "mern",
    "react",
    "vite",
    "express",
    "mongodb",
    "scaffold",
    "generator",
    "create-app"
  ],
  "author": "Muhammad Arsalan Warsi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MArsalanwarsi/create-modern-mern-app.git"
  },
  "bugs": {
    "url": "https://github.com/MArsalanwarsi/create-modern-mern-app/issues"
  },
  "homepage": "https://github.com/MArsalanwarsi/create-modern-mern-app#readme",
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1"
  }
}
